{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bonginkan/fairy_tale/schemas/helix-blocker-triage.schema.json",
  "title": "Fairy Tale Helix blocker triage record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "loop",
    "blockers",
    "final_readback"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2"
    },
    "artifact_type": {
      "const": "helix_blocker_triage"
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loop_id",
        "repo",
        "artifact_ref",
        "exact_head",
        "evaluated_at",
        "roles",
        "deadline",
        "usage",
        "ship_stage",
        "target",
        "claim_envelope",
        "working_branch"
      ],
      "properties": {
        "loop_id": {
          "$ref": "#/$defs/id"
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "artifact_ref": {
          "$ref": "#/$defs/evidenceRef"
        },
        "exact_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "evaluated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "roles": {
          "$ref": "#/$defs/roles"
        },
        "deadline": {
          "$ref": "#/$defs/deadline"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "ship_stage": {
          "$ref": "#/$defs/shipStage"
        },
        "target": {
          "$ref": "#/$defs/targetRecord"
        },
        "claim_envelope": {
          "$ref": "#/$defs/claimEnvelope"
        },
        "working_branch": {
          "$ref": "#/$defs/workingBranch"
        }
      }
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "final_readback": {
      "$ref": "#/$defs/finalReadback"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?([Zz]|[+-]\\d{2}:\\d{2})$",
      "description": "RFC 3339 date-time. The pattern carries the contract because `format` is advisory unless an optional format library is installed, so relying on it alone leaves timestamps unchecked in both the CLI evaluator and CI."
    },
    "evidenceRef": {
      "type": "string",
      "pattern": "^(https://[^\\s]+|sha256:[0-9a-f]{64}|(artifact|check|file|issue|log|receipt|run|source|test|trace|usage):[A-Za-z0-9][A-Za-z0-9._/@#:+-]{0,255})$"
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementer_id",
        "reviewer_ids",
        "priority_reviewer_id"
      ],
      "properties": {
        "implementer_id": {
          "$ref": "#/$defs/id"
        },
        "reviewer_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/ids"
            },
            {
              "minItems": 2
            }
          ]
        },
        "priority_reviewer_id": {
          "$ref": "#/$defs/id",
          "description": "The single reviewer holding the owner-priority disposition role. Must be one of reviewer_ids and must not be implementer_id. 'the second reviewer' names nobody once there are three."
        }
      }
    },
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "source",
        "source_ref",
        "clock_readings"
      ],
      "properties": {
        "at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "none",
            "explicit_owner",
            "explicit_policy"
          ]
        },
        "source_ref": {
          "type": "string"
        },
        "clock_readings": {
          "type": "array",
          "description": "Real clock values actually read, not felt. One per round start and per disposition.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "phase"
            ],
            "properties": {
              "at": {
                "$ref": "#/$defs/timestamp"
              },
              "phase": {
                "enum": [
                  "round_start",
                  "disposition",
                  "ship_decision"
                ]
              }
            }
          }
        },
        "minimum_shape": {
          "type": [
            "object",
            "null"
          ],
          "description": "Minimum coherent set pre-registered at the start of the deadline window. Null only when no deadline is in force.",
          "additionalProperties": false,
          "required": [
            "owner_goal_ref",
            "named_items",
            "hash",
            "registered_at"
          ],
          "properties": {
            "owner_goal_ref": {
              "type": "string",
              "minLength": 1
            },
            "named_items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Named items, never a count: '8 of 10' is not evidence when the remaining 2 are the substance."
            },
            "hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "registered_at": {
              "$ref": "#/$defs/timestamp"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "none"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "at": {
                "type": "null"
              },
              "source_ref": {
                "const": ""
              }
            }
          },
          "else": {
            "properties": {
              "at": {
                "$ref": "#/$defs/timestamp"
              },
              "source_ref": {
                "$ref": "#/$defs/evidenceRef"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "none"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "clock_readings": {
                "maxItems": 0
              },
              "minimum_shape": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "clock_readings": {
                "minItems": 1
              },
              "minimum_shape": {
                "type": "object"
              }
            },
            "required": [
              "minimum_shape"
            ]
          }
        }
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_5h_remaining",
        "secondary_weekly_remaining",
        "status",
        "source",
        "source_ref",
        "observed_at"
      ],
      "properties": {
        "primary_5h_remaining": {
          "$ref": "#/$defs/nullablePercentage"
        },
        "secondary_weekly_remaining": {
          "$ref": "#/$defs/nullablePercentage"
        },
        "status": {
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "source": {
          "enum": [
            "primary_check",
            "session_owner_observation",
            "self_report",
            "unknown"
          ]
        },
        "source_ref": {
          "type": "string"
        },
        "observed_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "primary_5h_remaining": {
                "type": "null"
              },
              "secondary_weekly_remaining": {
                "type": "null"
              },
              "source": {
                "const": "unknown"
              },
              "source_ref": {
                "const": ""
              },
              "observed_at": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "source_ref": {
                "$ref": "#/$defs/evidenceRef"
              },
              "observed_at": {
                "$ref": "#/$defs/timestamp"
              }
            },
            "anyOf": [
              {
                "properties": {
                  "primary_5h_remaining": {
                    "type": "number"
                  }
                }
              },
              {
                "properties": {
                  "secondary_weekly_remaining": {
                    "type": "number"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "fresh"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "source": {
                "enum": [
                  "primary_check",
                  "session_owner_observation"
                ]
              }
            }
          }
        }
      ]
    },
    "happyPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified",
        "check_ref",
        "summary"
      ],
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "check_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/evidenceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verified": {
                "const": true
              }
            },
            "required": [
              "verified"
            ]
          },
          "then": {
            "properties": {
              "check_ref": {
                "$ref": "#/$defs/evidenceRef"
              }
            }
          },
          "else": {
            "properties": {
              "check_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "shipAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "evidence_refs"
      ],
      "properties": {
        "reviewer_id": {
          "$ref": "#/$defs/id"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      }
    },
    "shipStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "basis",
        "basis_ref",
        "happy_path",
        "evidence_attestation"
      ],
      "properties": {
        "stage": {
          "enum": [
            "production",
            "dev_deploy"
          ]
        },
        "basis": {
          "enum": [
            "production_promotion",
            "owner_directive",
            "non_production_target",
            "early_development"
          ]
        },
        "basis_ref": {
          "$ref": "#/$defs/evidenceRef"
        },
        "happy_path": {
          "$ref": "#/$defs/happyPath"
        },
        "evidence_attestation": {
          "oneOf": [
            {
              "$ref": "#/$defs/shipAttestation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "const": "production"
              }
            },
            "required": [
              "stage"
            ]
          },
          "then": {
            "properties": {
              "basis": {
                "const": "production_promotion"
              }
            }
          },
          "else": {
            "properties": {
              "basis": {
                "enum": [
                  "owner_directive",
                  "non_production_target",
                  "early_development"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "const": "dev_deploy"
              },
              "happy_path": {
                "properties": {
                  "verified": {
                    "const": true
                  }
                },
                "required": [
                  "verified"
                ]
              }
            },
            "required": [
              "stage",
              "happy_path"
            ]
          },
          "then": {
            "properties": {
              "evidence_attestation": {
                "$ref": "#/$defs/shipAttestation"
              }
            }
          },
          "else": {
            "properties": {
              "evidence_attestation": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "shipDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "rationale"
      ],
      "properties": {
        "decision": {
          "enum": [
            "go",
            "hold"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "nullablePercentage": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "findingReviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "finding_ref"
      ],
      "properties": {
        "reviewer_id": {
          "$ref": "#/$defs/id"
        },
        "finding_ref": {
          "$ref": "#/$defs/evidenceRef"
        }
      }
    },
    "rebuttal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "outcome",
        "rationale",
        "evidence_refs"
      ],
      "properties": {
        "reviewer_id": {
          "$ref": "#/$defs/id"
        },
        "outcome": {
          "enum": [
            "accept",
            "reject"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      }
    },
    "tieBreak": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "outcome",
        "rationale",
        "evidence_refs"
      ],
      "properties": {
        "reviewer_id": {
          "$ref": "#/$defs/id"
        },
        "outcome": {
          "enum": [
            "sustain_blocker",
            "accept_objection"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      }
    },
    "objection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementer_id",
        "refuted_claim",
        "rationale",
        "evidence_refs",
        "rebuttal",
        "tie_break"
      ],
      "properties": {
        "implementer_id": {
          "$ref": "#/$defs/id"
        },
        "refuted_claim": {
          "const": "failure_sequence"
        },
        "rationale": {
          "type": "string",
          "minLength": 20
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "rebuttal": {
          "$ref": "#/$defs/rebuttal"
        },
        "tie_break": {
          "oneOf": [
            {
              "$ref": "#/$defs/tieBreak"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rebuttal": {
                "properties": {
                  "outcome": {
                    "const": "accept"
                  }
                },
                "required": [
                  "outcome"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "tie_break": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "tie_break": {
                "$ref": "#/$defs/tieBreak"
              }
            }
          }
        }
      ]
    },
    "humanReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audience",
        "reported",
        "summary",
        "report_ref"
      ],
      "properties": {
        "audience": {
          "const": "human_owner"
        },
        "reported": {
          "const": true
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "report_ref": {
          "$ref": "#/$defs/evidenceRef"
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "priority",
        "rationale",
        "concurred_by",
        "issue_url",
        "human_report"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "fix_now",
            "defer_issue",
            "not_blocker"
          ]
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "concurred_by": {
          "$ref": "#/$defs/ids"
        },
        "issue_url": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[1-9][0-9]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "human_report": {
          "oneOf": [
            {
              "$ref": "#/$defs/humanReport"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "defer_issue"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "concurred_by": {
                "minItems": 1
              },
              "issue_url": {
                "type": "string"
              },
              "human_report": {
                "$ref": "#/$defs/humanReport"
              }
            }
          },
          "else": {
            "properties": {
              "issue_url": {
                "type": "null"
              },
              "human_report": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "summary",
        "failure_sequence",
        "preconditions",
        "probability_percent",
        "impact",
        "risk_rationale",
        "finding_class",
        "protected_floor",
        "floor_basis",
        "estimated_fix_minutes",
        "evidence_refs",
        "finding_reviewer",
        "objection",
        "resolution"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "failure_sequence": {
          "type": "string",
          "minLength": 20
        },
        "preconditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "probability_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "impact": {
          "enum": [
            "negligible",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "risk_rationale": {
          "type": "string",
          "minLength": 20
        },
        "finding_class": {
          "enum": [
            "happy_path",
            "abnormal_path",
            "hardening",
            "other"
          ]
        },
        "protected_floor": {
          "enum": [
            "none",
            "secret_credential",
            "data_loss",
            "production",
            "authority_permission",
            "security",
            "required_acceptance",
            "unapproved_branch_change"
          ],
          "description": "Floor class. 'unapproved_branch_change' is unconditional: it needs no demonstrated reach or failure sequence, and it is not deferrable at any level of concurrence. Its only exits are a cited owner approval or returning to the recorded branch and consolidating."
        },
        "floor_basis": {
          "enum": [
            "not_applicable",
            "demonstrated",
            "precautionary"
          ]
        },
        "estimated_fix_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "finding_reviewer": {
          "$ref": "#/$defs/findingReviewer"
        },
        "objection": {
          "oneOf": [
            {
              "$ref": "#/$defs/objection"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "protected_floor": {
                "const": "none"
              }
            },
            "required": [
              "protected_floor"
            ]
          },
          "then": {
            "properties": {
              "floor_basis": {
                "const": "not_applicable"
              }
            }
          },
          "else": {
            "properties": {
              "floor_basis": {
                "enum": [
                  "demonstrated",
                  "precautionary"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "protected_floor": {
                "enum": [
                  "secret_credential",
                  "data_loss",
                  "production",
                  "authority_permission",
                  "required_acceptance"
                ]
              }
            },
            "required": [
              "protected_floor"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "properties": {
                  "disposition": {
                    "enum": [
                      "fix_now",
                      "not_blocker"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "protected_floor": {
                "const": "security"
              },
              "finding_class": {
                "enum": [
                  "happy_path",
                  "abnormal_path",
                  "other"
                ]
              }
            },
            "required": [
              "protected_floor",
              "finding_class"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "properties": {
                  "disposition": {
                    "enum": [
                      "fix_now",
                      "not_blocker"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "protected_floor": {
                "const": "security"
              },
              "floor_basis": {
                "const": "demonstrated"
              }
            },
            "required": [
              "protected_floor",
              "floor_basis"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "properties": {
                  "disposition": {
                    "enum": [
                      "fix_now",
                      "not_blocker"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "finding_class": {
                "const": "happy_path"
              }
            },
            "required": [
              "finding_class"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "properties": {
                  "disposition": {
                    "enum": [
                      "fix_now",
                      "not_blocker"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "finalReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deferred_blocker_ids",
        "retained_blocker_ids",
        "not_blocker_ids",
        "reported_to_human",
        "report_ref",
        "ship_decision"
      ],
      "properties": {
        "ship_decision": {
          "$ref": "#/$defs/shipDecision"
        },
        "deferred_blocker_ids": {
          "$ref": "#/$defs/ids"
        },
        "retained_blocker_ids": {
          "$ref": "#/$defs/ids"
        },
        "not_blocker_ids": {
          "$ref": "#/$defs/ids"
        },
        "reported_to_human": {
          "type": "boolean"
        },
        "report_ref": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ship_decision": {
                "properties": {
                  "decision": {
                    "const": "go"
                  }
                },
                "required": [
                  "decision"
                ]
              }
            },
            "required": [
              "ship_decision"
            ]
          },
          "then": {
            "properties": {
              "retained_blocker_ids": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reported_to_human": {
                "const": true
              }
            },
            "required": [
              "reported_to_human"
            ]
          },
          "then": {
            "properties": {
              "report_ref": {
                "$ref": "#/$defs/evidenceRef"
              }
            }
          },
          "else": {
            "properties": {
              "report_ref": {
                "const": ""
              }
            }
          }
        }
      ]
    },
    "pinnedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "content_hash",
        "captured_at"
      ],
      "description": "A source that can be edited after the fact (owner directive, issue body, comment). Pinned by content, not by ref alone.",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "captured_at": {
          "$ref": "#/$defs/timestamp"
        },
        "edit_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Server-recorded edit count at capture time; null when the surface does not expose one."
        }
      }
    },
    "targetRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "path",
        "layer",
        "canonical_owner",
        "directive_refs",
        "duplication_policy"
      ],
      "description": "Where the change belongs, resolved from the owner directive and system of record before content work.",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "string",
          "minLength": 1
        },
        "canonical_owner": {
          "type": "string",
          "minLength": 1
        },
        "directive_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pinnedSource"
          }
        },
        "propagation_path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Mirrored copies the change must reach to stay in parity."
        },
        "duplication_policy": {
          "enum": [
            "canonical_only",
            "mirrored_byte_identical",
            "reference_only"
          ]
        },
        "resolved_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "claimEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_ref",
        "claim_snapshot_refs"
      ],
      "description": "Union of merge-base contracts/tests and the pinned directive/acceptance. Judging on either half alone drops protected behaviour.",
      "properties": {
        "baseline_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Merge-base commit the contracts and required tests are read from. A commit id, not a branch name: the half of the envelope that is 'fixed by commit' is only fixed if what it points at cannot move.",
          "pattern": "^[0-9a-f]{40}$"
        },
        "claim_snapshot_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pinnedSource"
          },
          "minItems": 1
        }
      }
    },
    "workingBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fixed_by_ref"
      ],
      "description": "Fixed once at effort start. Fixing is not creating; changing it later needs owner approval as a citable ref.",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "fixed_by_ref": {
          "type": "string",
          "minLength": 1
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Owner approval for a change of branch, cited as a ref. Null when the branch never moved."
        },
        "remedy": {
          "enum": [
            "none",
            "approval_produced",
            "returned_and_consolidated"
          ]
        }
      }
    }
  }
}
